DISCORD_TOKEN=put-your-bot-token-here
# Optional: your server ID makes slash commands appear instantly
GUILD_ID=
# Public URL of your league logo (upload the logo to Discord/Imgur and paste the link)
LEAGUE_LOGO_URL=
# "View Profile" button link. {user_id} is replaced with the player's Discord ID.
# Swap this for your league website profile page later.
PROFILE_URL=https://discord.com/users/{user_id}
LEAGUE_NAME=VCL X NAPXR.GG | PitchX
# Short name used on embed headers/footers (e.g. "PitchX Transactions")
LEAGUE_SHORT=PitchX
# Link for the "Open Your Dashboard" button on reminders (leave empty to hide the button)
DASHBOARD_URL=
# Days between league reminders
REMINDER_DAYS=14
